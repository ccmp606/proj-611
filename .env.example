# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit it.

# Sepolia RPC from Infura or Alchemy
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<YOUR_INFURA_PROJECT_ID>

# Private key of the wallet that signs storeHash() transactions
# Must hold Sepolia ETH — get some from https://sepoliafaucet.com
WALLET_PRIVATE_KEY=<0x...64_hex_chars>

# Contract address — fill in after running: npm run deploy
CONTRACT_ADDRESS=

# Etherscan API key — only needed for: npm run verify
ETHERSCAN_API_KEY=<YOUR_ETHERSCAN_API_KEY>
